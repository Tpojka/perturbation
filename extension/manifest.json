{
  "manifest_version": 3,
  "name": "Perturbation",
  "version": "1.3.0",
  "description": "One toolbar lamp for every coding agent on this machine: red while any agent works, amber when one needs you, green when all are free.",
  "homepage_url": "https://perturbation.tpojka.com",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "alarms",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Perturbation: connecting…",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/lamp-grey-16.png",
      "32": "icons/lamp-grey-32.png",
      "48": "icons/lamp-grey-48.png",
      "128": "icons/lamp-grey-128.png"
    }
  },
  "icons": {
    "16": "icons/lamp-green-16.png",
    "32": "icons/lamp-green-32.png",
    "48": "icons/lamp-green-48.png",
    "128": "icons/lamp-green-128.png"
  }
}
